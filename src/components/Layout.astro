---
import "../styles/global.css";
import SiteHeader from "./SiteHeader.astro";

const { title = "Noah O'Connor's Portfolio" } = Astro.props;
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Noah O'Connor's gameplay programming and technical design portfolio. Explore combat, procedural systems, AI, and multiplayer work in Unreal Engine and Unity." />
    <link rel="icon" type="image/svg+xml" href="/images/site/NLogo.svg" />
    <title>{title}</title>
</head>

<body>
<SiteHeader />

<slot />
</body>
</html>

<script>
    document.querySelectorAll<HTMLVideoElement>("video").forEach((video) => {
        video.controls = false;
        video.tabIndex = 0;
        let hovered = false;
        let focused = false;
        const updateControls = () => { video.controls = hovered || focused; };
        video.addEventListener("pointerenter", (event) => {
            if (event.pointerType === "mouse" || event.pointerType === "pen") hovered = true;
            updateControls();
        });
        video.addEventListener("pointerleave", () => {
            hovered = false;
            updateControls();
        });
        video.addEventListener("focus", () => {
            focused = true;
            updateControls();
        });
        video.addEventListener("blur", () => {
            focused = false;
            updateControls();
        });
        video.addEventListener("pointerdown", (event) => {
            if (event.pointerType === "touch") video.focus();
        });
    });
</script>
