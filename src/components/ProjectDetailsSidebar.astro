---
import type { CollectionEntry } from "astro:content";
interface Props { project: CollectionEntry<"projects">; }
const { project } = Astro.props;
const { role, engine, language, genre, perspective, status, technologies, specialties, links } = project.data;
const facts = [["Role", role], ["Engine", engine], ["Languages", language], ["Genre", genre], ["Perspective", perspective], ["Status", status]];
---
<aside class="case-sidebar" aria-label={`${project.data.title} project details`}>
    <section><h2>Project Details</h2><dl class="case-facts">
        {facts.filter(([, value]) => value).map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
    </dl></section>
    {technologies.length > 0 && <section><h2>Core Technologies</h2><div class="tags">{technologies.map(tag => <span>{tag}</span>)}</div></section>}
    {specialties.length > 0 && <section><h2>Specialties</h2><div class="tags">{specialties.map(tag => <span>{tag}</span>)}</div></section>}
    {links?.length > 0 && <section><h2>Links</h2>{links.map(link => <a class="store-button" href={link.url} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</section>}
</aside>
