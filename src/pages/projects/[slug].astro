---
import { getCollection } from "astro:content";
import Layout from "../../components/Layout.astro";
import ProjectShowcaseCarousel from "../../components/ProjectShowcaseCarousel.astro";
import ProjectContentSections from "../../components/ProjectContentSections.astro";
import CrimsonKnightCaseStudy from "../../components/CrimsonKnightCaseStudy.astro";
import ProjectCaseStudyLayout from "../../components/ProjectCaseStudyLayout.astro";
import ProjectDetailsSidebar from "../../components/ProjectDetailsSidebar.astro";
import LutrCaseStudy from "../../components/LutrCaseStudy.astro";
import RelictCaseStudy from "../../components/RelictCaseStudy.astro";
import BloxelsCaseStudy from "../../components/BloxelsCaseStudy.astro";
import KittyCasinoCaseStudy from "../../components/KittyCasinoCaseStudy.astro";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    return projects.map((project) => ({
        params: { slug: project.data.slug },
        props: { project },
    }));
}

const { project } = Astro.props;
const caseStudies = { lutr: LutrCaseStudy, relict: RelictCaseStudy, bloxels: BloxelsCaseStudy, "kitty-casino": KittyCasinoCaseStudy };
const CaseStudy = caseStudies[project.data.slug as keyof typeof caseStudies];
const backdrop = project.data.backgroundImage || (project.data.slug === "crimson-knight"
    ? "/images/projects/crimson-knight/CrimsonKnightScreenshot1.jpg"
    : project.data.media.find(item => item.type === "image")?.imgSrc || project.data.coverImage);
---

<Layout title={project.data.title}>
    <main class="page project-page" style={`--project-backdrop: ${backdrop ? `url('${backdrop}')` : "none"}`}>
        <ProjectShowcaseCarousel project={project} />

        {project.data.slug === "crimson-knight" ? <CrimsonKnightCaseStudy /> : (
            <ProjectCaseStudyLayout>
                {CaseStudy ? <CaseStudy /> : <ProjectContentSections sections={project.data.sections} />}
                <ProjectDetailsSidebar slot="sidebar" project={project} />
            </ProjectCaseStudyLayout>
        )}
    </main>
</Layout>
